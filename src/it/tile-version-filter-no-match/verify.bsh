import java.io.*;

File file = new File( basedir, "build.log" );
if ( !file.isFile() ) {
    throw new FileNotFoundException( "Could not find build log: " + file );
}

String content = new Scanner(file).useDelimiter("\\Z").next();

if (!content.contains("tileVersionFilter 'i([3,4))' excluded all versions of tile net.stickycode.tile:sticky-tile-library:[1.1,2) (available: 1.1, 1.2)")) {
  throw new Exception("Expected build to fail because the tileVersionFilter excludes all versions");
}
